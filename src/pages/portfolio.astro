
---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const recentProjects = allProjects
  .filter(p => p.data.highlight)
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf())
  .slice(0, 3);

const allPosts = await getCollection('blog');
const latestPost = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---

<head>
  <title>Henrik Sedvall</title>
</head>

<MainLayout>

  <!-- About -->
  <section class="section about-section">
    <h2>hello</h2>
    <div class="about-flex">
      <div class="about-text">
        <p>
          Software engineer with 9 years experience in data, AI, and game dev &mdash;
          passionate about building great teams and creative tech solutions.
        </p>
      </div>
    </div>
  </section>

  <!-- Recent Work -->
  <section class="section">
    <h2>recent work</h2>
    <div class="project-grid">
      {recentProjects.length === 0 && <p>No projects yet.</p>}
      {recentProjects.map(project => (
        <a href={`/projects/${project.slug}/`} class="project-card">
          <div class="project-img-wrapper">
            {project.data.heroImg && (
              <img src={project.data.heroImg} alt={project.data.title} class="project-img" />
            )}
            <div class="project-title-overlay">{project.data.title}</div>
          </div>
          <div class="project-info">
            <p>{project.data.description}</p>
          </div>
        </a>
      ))}
    </div>
    <a href="/projects" class="view-all">all projects &rarr;</a>
  </section>

  <!-- Latest Post -->
  {latestPost && (
    <section class="section">
      <h2>latest post</h2>
      <a href={`/blog/${latestPost.slug}/`} class="post-card">
        <div class="post-card-inner">
          <span class="post-date">
            {latestPost.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric'
            })}
          </span>
          <h3 class="post-title">{latestPost.data.title}</h3>
          <p class="post-desc">{latestPost.data.description}</p>
        </div>
      </a>
      <a href="/blog" class="view-all">all posts &rarr;</a>
    </section>
  )}

  <!-- Experience -->
  <section class="section experience-section">
    <h2>experience</h2>
    <div class="experience-timeline">
      <div class="experience-item">
        <div class="experience-date">2025</div>
        <h3 class="experience-title">Senior Developer</h3>
        <div class="experience-company">Consid</div>
      </div>
      <div class="experience-item">
        <div class="experience-date">2023</div>
        <h3 class="experience-title">AI Programmer</h3>
        <div class="experience-company">Dimfrost Studio</div>
      </div>
      <div class="experience-item">
        <div class="experience-date">2019 - 2024</div>
        <h3 class="experience-title">Machine Learning Engineer</h3>
        <div class="experience-company">Advectas / Capgemini</div>
      </div>
      <div class="experience-item">
        <div class="experience-date">2017 - 2018</div>
        <h3 class="experience-title">Software Engineer</h3>
        <div class="experience-company">Ericsson</div>
      </div>
    </div>
  </section>

  <style>
    * {
      margin: 0;
      padding: 0;
    }

    .section {
      padding: 0.5rem 1.5rem 1.5rem;
      max-width: 1200px;
      margin: 0 auto 1.5rem auto;
      background: var(--section-background);
      border-radius: 0.3rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    }

    .section h2 {
      font-family: var(--header-font);
      font-size: var(--header-font-size);
      color: var(--text-color);
      text-align: left;
      margin-top: 1rem;
      margin-bottom: 0.5rem;
    }

    /* -- ABOUT -- */
    .about-flex {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .about-img {
      width: 270px;
      height: 270px;
      object-fit: cover;
      border-radius: 20%;
      border: 2px solid var(--content-border-color);
      flex-shrink: 0;
      margin-top: 1rem;
      margin-bottom: 0.5rem;
    }

    .about-text {
      flex: 1;
      font-size: 1.3rem;
    }

    /* -- PROJECTS -- */
    .project-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1rem;
      padding: 1rem 0 0 0;
    }

    .project-card {
      background: var(--background-color);
      border-radius: 0.2rem;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
    }

    .project-card:hover {
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      background: var(--card-project-hover);
    }

    .project-img-wrapper {
      position: relative;
      width: 100%;
      height: 200px;
      overflow: hidden;
    }

    .project-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(6px);
      transition: filter 0.0s;
    }

    .project-card:hover .project-img {
      filter: blur(0);
    }

    .project-title-overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: var(--card-project-title);
      font-family: 'VT323';
      font-size: 2.8rem;
      z-index: 2;
      pointer-events: none;
      text-align: center;
      width: 90%;
      white-space: pre-line;
      transition: opacity 0.3s;
      opacity: 1;
    }

    .project-card:hover .project-title-overlay {
      opacity: 0;
    }

    .project-info {
      padding: 1.5rem;
      border: 1.5px solid var(--card-project-border);
    }

    .project-info p {
      line-height: 1.6;
    }

    /* -- LATEST POST -- */
    .post-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      text-decoration: none;
      color: inherit;
      padding: 1.5rem;
      margin-top: 1rem;
      border: 1.5px solid var(--card-project-border);
      border-radius: 0.2rem;
      transition: background 0.2s, border-color 0.2s;
    }

    .post-card:hover {
      background: var(--card-project-hover);
      border-color: var(--the-accent);
    }

    .post-card-inner {
      flex: 1;
    }

    .post-date {
      font-size: 0.8rem;
      color: var(--experience-date);
      font-family: 'VT323', monospace;
      display: block;
      margin-bottom: 0.4rem;
    }

    .post-title {
      font-family: 'VT323', monospace;
      font-size: 1.8rem;
      font-weight: normal;
      color: var(--text-color);
      margin-bottom: 0.5rem;
      line-height: 1.1;
    }

    .post-desc {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--experience-date);
    }

    .post-arrow {
      font-size: 1.8rem;
      color: var(--the-accent);
      flex-shrink: 0;
    }

    /* -- VIEW ALL LINK -- */
    .view-all {
      display: inline-block;
      margin-top: 1rem;
      font-size: 0.85rem;
      color: var(--experience-date);
      text-decoration: none;
      letter-spacing: 0.03em;
      transition: color 0.2s;
    }

    .view-all:hover {
      color: var(--the-accent);
    }

    /* -- EXPERIENCE -- */
    .experience-section {
      position: relative;
      padding: 0rem 1rem 1rem;
    }

    .experience-timeline {
      margin: 1.5rem 0 0;
    }

    .experience-item {
      display: grid;
      grid-template-columns: 7.5rem 1fr auto;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--content-border-color);
    }

    .experience-item:first-child {
      border-top: 1px solid var(--content-border-color);
    }

    .experience-item:hover {
      transform: translateX(2px);
    }

    .experience-date {
      color: var(--experience-date);
      font-size: 1.2rem;
      margin-bottom: 0.3rem;
      font-family: 'VT323', monospace;
    }

    .experience-title {
      color: var(--experience-title);
      font-size: 1.3rem;
      font-weight: normal;
      margin-bottom: 0.2rem;
    }

    .experience-company {
      color: var(--experience-company);
      font-size: 1.1rem;
    }

    /* -- RESPONSIVE -- */
    @media (max-width: 768px) {
      .section {
        padding: 0rem 0.5rem 0.5rem;
        margin: 0 auto 1.5rem auto;
      }

      .about-flex {
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
      }

      .about-img {
        width: 80%;
        height: auto;
        margin: 0;
      }

      .experience-timeline {
        margin-top: 1.5rem;
      }

      .experience-item {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto;
      }

      .experience-date { grid-column: 1; grid-row: 1; }
      .experience-title { grid-column: 1 / -1; grid-row: 2; }
      .experience-company { grid-column: 2; grid-row: 1; text-align: right; }

      .post-card {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

</MainLayout>

