---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  image?: ImageMetadata | string;
  video?: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { image, video, alt, class: className, loading = 'lazy' } = Astro.props;

const poster =
  video && image
    ? typeof image === 'string'
      ? image
      : (await getImage({ src: image, width: 960 })).src
    : undefined;
---
{video ? (
  <video class:list={['cover', className]} autoplay muted loop playsinline poster={poster} aria-label={alt}>
    <source src={video} type="video/mp4" />
  </video>
) : typeof image === 'string' ? (
  <img class:list={['cover', className]} src={image} alt={alt} loading={loading} />
) : image ? (
  <Image class:list={['cover', className]} src={image} alt={alt} width={960} loading={loading} />
) : null}

<style>
  .cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
