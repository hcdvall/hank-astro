---
import { NAV_LINKS, SITE_NAME } from "../consts";

const brand = SITE_NAME.toUpperCase().replace(" ", "_");
const path = Astro.url.pathname.replace(/\/$/, "");

function ariaCurrent(href: string) {
  if (path === href) return "page";
  if (path.startsWith(href + "/")) return "true";
  return undefined;
}
---
<nav class="navbar">
  <div class="navbar-brand">
    <a href="/">
      <span class="glitch-navbar" data-text={brand}>{brand}</span>
    </a>
  </div>

  <!-- Only visible on mobile -->
  <button
    class="hamburger"
    id="hamburger-btn"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="navbar-links"
  >
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>

  <!-- A row on desktop, a dropdown toggled by the hamburger on mobile -->
  <ul class="navbar-links" id="navbar-links">
    {NAV_LINKS.map(link => (
      <li>
        <a href={link.href} aria-current={ariaCurrent(link.href)}>{link.label}</a>
      </li>
    ))}
    <li>
      <button class="theme-toggle" aria-label="Toggle light and dark theme">
        <svg class="lamp-icon" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.293,17.293l-3,3a1,1,0,0,0,1.414,1.414l3-3a1,1,0,0,0-1.414-1.414Z"/><path d="M20.707,20.293l-3-3a1,1,0,0,0-1.414,1.414l3,3a1,1,0,0,0,1.414-1.414Z"/><path d="M12,17a1,1,0,0,0-1,1v3a1,1,0,0,0,2,0V18A1,1,0,0,0,12,17Z"/><path d="M6,15H18a1,1,0,0,0,0-2H17V12a5,5,0,0,0-4.02-4.9A.826.826,0,0,0,13,7V3a1,1,0,0,0-2,0V7a.826.826,0,0,0,.02.1A5,5,0,0,0,7,12v1H6a1,1,0,0,0,0,2Z"/>
        </svg>
      </button>
    </li>
  </ul>
</nav>

<script>
  function setMenuOpen(open: boolean) {
    document.getElementById("navbar-links")?.classList.toggle("open", open);
    document.getElementById("hamburger-btn")?.setAttribute("aria-expanded", String(open));
  }

  function toggleTheme() {
    const root = document.documentElement;
    const theme = root.dataset.theme === "light" ? "dark" : "light";
    root.dataset.theme = theme;
    localStorage.setItem("theme", theme);
  }

  // The navbar is re-rendered on every client-side navigation, so its
  // listeners are attached on each page load.
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("hamburger-btn");
    const menu = document.getElementById("navbar-links");
    btn?.addEventListener("click", () => setMenuOpen(!menu?.classList.contains("open")));
    document.querySelectorAll(".theme-toggle").forEach(toggle => {
      toggle.addEventListener("click", toggleTheme);
    });
  });

  // Close the mobile menu when clicking outside it
  document.addEventListener("click", e => {
    const target = e.target as Node;
    const btn = document.getElementById("hamburger-btn");
    const menu = document.getElementById("navbar-links");
    if (menu?.classList.contains("open") && !menu.contains(target) && !btn?.contains(target)) {
      setMenuOpen(false);
    }
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    max-width: 1140px;
    height: 40px;
    margin: 0 auto;
    padding: 1.5rem 3.2rem;
    background-color: var(--navbar-background);
    color: var(--navbar-text-color);
    font-size: 1rem;
    font-family: var(--header-font);
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-shadow: 0px 0px 3px var(--navbar-glow-color), 0px 0px 3px var(--navbar-glow-color);
    z-index: 1000;
    opacity: 0.95;
  }

  /* Brand with glitch effect */
  .navbar-brand {
    flex-shrink: 0;
  }

  .navbar-brand a {
    text-decoration: none;
    color: inherit;
  }

  .glitch-navbar {
    display: block;
    font-size: 3.2rem;
    font-weight: bold;
    color: var(--dracula-cyan);
    position: relative;
    font-family: var(--font-display);
    animation: glitch-navbar 3s infinite;
  }

  .glitch-navbar::before,
  .glitch-navbar::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .glitch-navbar::before {
    animation: glitch-navbar 0.3s infinite;
    color: var(--the-accent);
    z-index: -1;
  }

  .glitch-navbar::after {
    animation: glitch-navbar-2 0.3s infinite;
    color: var(--dracula-cyan);
    z-index: -2;
  }

  @keyframes glitch-navbar {
    0%, 100% { transform: translate(0); }
    20% { transform: translate(-1px, 1px); }
    40% { transform: translate(-1px, -1px); }
    60% { transform: translate(1px, 1px); }
    80% { transform: translate(1px, -1px); }
  }

  @keyframes glitch-navbar-2 {
    0%, 100% { transform: translate(0); }
    20% { transform: translate(1px, -1px); }
    40% { transform: translate(1px, 1px); }
    60% { transform: translate(-1px, -1px); }
    80% { transform: translate(-1px, 1px); }
  }

  /* Links */
  .navbar-links {
    list-style: none;
    margin: 0;
  }

  .navbar-links a {
    color: var(--navbar-text-color);
    text-decoration: inherit;
    transition: background-color 0.2s, transform 0.2s;
  }

  .navbar-links a:hover {
    background-color: var(--button-hover);
  }

  .navbar-links a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* Hamburger button */
  .hamburger {
    display: block;
    font-size: 1rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-color);
  }

  .hamburger-line {
    display: block;
    width: 32px;
    height: 4px;
    margin: 6px 0;
    background: var(--text-color);
    border-radius: 2px;
    transition: background 0.2s;
  }

  /* Theme toggle */
  .theme-toggle {
    background-color: var(--background-color);
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-weight: bold;
    font-size: 20px;
  }

  .lamp-icon {
    color: var(--text-color);
    width: 32px;
    height: 32px;
  }

  .lamp-icon:hover {
    color: var(--the-yellow);
    transform: scale(1.2);
  }

  /* Desktop: links in a row, no hamburger */
  @media (min-width: 968px) {
    .hamburger {
      display: none;
    }

    .navbar-links {
      display: flex;
      flex-direction: row;
      gap: 0.5rem;
      padding: 0;
      align-items: center;
      margin-left: auto;
    }

    .navbar-links a {
      padding: 0.3em 0.8em;
      border-radius: 0.3em;
    }

    .navbar-links a:hover {
      transform: scale(1.05);
    }
  }

  /* Mobile: dropdown menu, hidden until the hamburger opens it */
  @media (max-width: 967px) {
    .navbar-links {
      display: none;
      flex-direction: column;
      gap: 1rem;
      padding: 2rem 1rem 1rem 1rem;
      width: 300px;
      max-width: 90vw;
      position: fixed;
      top: 0px;
      left: 50%;
      transform: translate(-50%, 0);
      background: var(--navbar-background);
      z-index: 999;
      align-items: center;
      text-align: center;
      border: 2px solid var(--content-border-color);
      border-radius: 0.5rem;
      box-shadow: 0 0 2px var(--navbar-glow-color);
    }

    .navbar-links.open {
      display: flex;
    }

    .navbar-links a {
      padding: 0.3em;
    }

    .navbar-links a:hover {
      transform: scale(1.15);
    }
  }

  @media (max-width: 700px) {
    .navbar {
      padding: 1.5rem 0.5rem;
    }
    .navbar-links {
      top: 1.0rem;
      max-width: none;
    }
  }
</style>
