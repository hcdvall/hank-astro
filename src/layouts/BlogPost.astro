---
import MainLayout from './MainLayout.astro';
import { formatDate } from '../utils';

const { title, pubDate, description } = Astro.props;
---
<MainLayout>
  <article class="blog-post">
    <header class="blog-post-header">
      <div class="blog-post-title">{"> " + " " + title}</div>
      <p class="blog-post-description">{description}</p>
    </header>

    <section class="blog-post-content prose">
        <slot />
    </section>

    <footer class="blog-post-footer">
        <p class="blog-post-date">
          Published on {formatDate(pubDate)}
        </p>
      </footer>
  </article>

  <style>
    .blog-post {
      max-width: 900px;
      margin: 0 auto;
      padding: 0px;
    }

    .blog-post-header {
      margin-bottom: 20px;
      text-align: left;
    }

    .blog-post-title {
      font-size: 3.0em;
      font-family: var(--font-display);
      color: var(--heading-accent);
      margin: 0;
      text-shadow: 0px 0px 2px var(--heading-accent), 0px 0px 2px var(--heading-accent);
    }

    .blog-post-date {
      font-size: 0.9em;
      margin: 5px 0;
    }

    .blog-post-description {
      font-size: 1.2em;
      margin: 10px 0;
    }

    .blog-post-content :global(h2) {
      border-bottom: 1px solid var(--markdown-header-color);
      padding-bottom: 0.3rem;
    }

    @media (max-width: 900px) {
      .blog-post {
        padding: 0 1rem;
      }
    }
  </style>
</MainLayout>
