---
import MainLayout from './MainLayout.astro';
import CoverMedia from '../components/CoverMedia.astro';
import { formatDate } from '../utils';

interface Props {
  title: string;
  description: string;
  startDate: Date;
  heroImg?: string;
}

const { title, startDate, description, heroImg } = Astro.props;
---
<MainLayout title={title} description={description}>
  <article class="project">
    <header class="project-header">
      <div class="hero-img-container">
        <CoverMedia image={heroImg} alt="" loading="eager" />
      </div>
      <h1 class="hero-title">{title}</h1>
    </header>

    <section class="project-content prose">
      <slot />
    </section>

    <footer class="project-footer">
      <p class="project-date">
        Started on <time datetime={startDate.toISOString()}>{formatDate(startDate)}</time>
      </p>
    </footer>
  </article>

  <style>
    .project {
      max-width: 900px;
      margin: 0 auto;
      padding: 0px;
    }

    .project-header {
      margin-bottom: 20px;
      text-align: left;
    }

    .project-date {
      font-size: 0.9em;
      margin: 5px 0;
    }

    .project-content {
      max-width: 900px;
      margin: 0 auto;
    }

    /* hero image styling */
    .hero-img-container {
      position: relative;
      width: 100%;
      height: 200px;
      margin-bottom: 1.5rem;
      overflow: hidden;
      border-radius: 0.5rem;
    }
    .hero-img-container :global(.cover) {
      filter: blur(3px);
      border-radius: 0.5rem;
    }
    .hero-title {
      position: absolute;
      margin: 0;
      top: 2rem;
      left: 50%;
      transform: translate(-50%, 25%);
      color: var(--heading-accent);
      padding: 0.5em 1em;
      border-radius: 0.5em;
      font-size: 5rem;
      font-weight: bold;
      font-family: var(--font-display);
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
      pointer-events: none;
      white-space: nowrap;
    }

    @media (max-width: 900px) {
      .project {
        padding: 0 1rem;
      }
    }
  </style>
</MainLayout>