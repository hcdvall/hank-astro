---
import MainLayout from './MainLayout.astro';
import { formatDate } from '../utils';

const { title, startDate, description, author, heroImg, highlight} = Astro.props;
---
<MainLayout>
  <article class="project">
    <header class="project-header">
      <div class="hero-img-container">
        <img src={heroImg} class="hero-img" alt={title} />
      </div>
      <div class="hero-title">{title}</div>
    </header>

    <section class="project-content prose">
      <slot />
    </section>

    <footer class="project-footer">
      <p class="project-date">
        Started on {formatDate(startDate)}
      </p>
    </footer>
  </article>

  <style>
    .project {
      max-width: 900px;
      margin: 0 auto;
      padding: 0px;
    }

    .project-header {
      margin-bottom: 20px;
      text-align: left;
    }

    .project-date {
      font-size: 0.9em;
      margin: 5px 0;
    }

    .project-content {
      max-width: 900px;
      margin: 0 auto;
    }

    /* hero image styling */
    .hero-img-container {
      position: relative;
      width: 100%;
      height: 200px;
      margin-bottom: 1.5rem;
      overflow: hidden;
      border-radius: 0.5rem;
    }
    .hero-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(3px);
      display: block;
      border-radius: 0.5rem;
      box-shadow: 0 2px 12px 0 rgba(0,0,0,0.10);
      position: relative;
    }
    .hero-title {
      position: absolute;
      top: 2rem;
      left: 50%;
      transform: translate(-50%, 25%);
      color: var(--heading-accent);
      padding: 0.5em 1em;
      border-radius: 0.5em;
      font-size: 5rem;
      font-weight: bold;
      font-family: var(--font-display);
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
      pointer-events: none;
      white-space: nowrap;
    }

    :global(.project-content img) {
      width: 350px;           /* Default size */
      max-width: 100%;        /* Shrink to fit container */
      height: 300px;          /* Keep aspect ratio when shrinking */
      object-fit: cover;
      border-radius: 0.5rem;
      margin: 1rem auto;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      display: inline-flex; 
    }

    @media (max-width: 900px) {
      .project {
        padding: 0rem 1.0rem;

      }

      :global(.project-content img) {
        width: 100%;          /* Full width on small screens */
        height: auto;         /* Maintain aspect ratio */
        margin: 1rem auto 0.5rem auto; /* Use margin-top instead of padding-top */
      }
    }

  </style>
</MainLayout>